generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("PAYMENT_DATABASE_URL")
}

model Payment {
  id                 Int      @id @default(autoincrement())
  uuid               String   @unique @default(uuid()) @db.VarChar(36)
  parentOrderId      String   @db.VarChar(36)
  provider           String   @db.VarChar(64)
  providerPaymentId  String?  @db.VarChar(128)
  idempotencyKey     String   @unique @db.VarChar(128)
  status             String   @default("PENDING") @db.VarChar(32)
  amount             Decimal  @db.Decimal(12, 2)
  currency           String   @default("INR") @db.VarChar(8)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  refunds Refund[]
}

model Refund {
  id                 Int      @id @default(autoincrement())
  uuid               String   @unique @default(uuid()) @db.VarChar(36)
  paymentId          Int
  idempotencyKey     String   @unique @db.VarChar(128)
  status             String   @default("PENDING") @db.VarChar(32)
  amount             Decimal  @db.Decimal(12, 2)
  reason             String?  @db.VarChar(255)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
}
