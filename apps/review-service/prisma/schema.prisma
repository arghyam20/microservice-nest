generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("REVIEW_DATABASE_URL")
}

model Review {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.VarChar(36)
  bookingId     String   @db.VarChar(36)
  productId     String?  @db.VarChar(36)
  vendorId      String?  @db.VarChar(36)
  businessId    String?  @db.VarChar(36)
  reviewerUserId String  @db.VarChar(36)
  rating        Int
  comment       String?  @db.Text
  verified      Boolean  @default(false)
  status        String   @default("PUBLISHED") @db.VarChar(32)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([vendorId])
  @@index([bookingId])
}
