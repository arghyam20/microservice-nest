generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("BOOKING_DATABASE_URL")
}

model ParentOrder {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.VarChar(36)
  customerId    String   @db.VarChar(36)
  status        String   @default("PENDING") @db.VarChar(32)
  totalAmount   Decimal  @db.Decimal(12, 2)
  correlationId String?  @db.VarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendorOrders VendorOrder[]
}

model VendorOrder {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid()) @db.VarChar(36)
  parentOrderId Int
  vendorId      String   @db.VarChar(36)
  businessId    String?  @db.VarChar(36)
  status        String   @default("PENDING") @db.VarChar(32)
  totalAmount   Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parentOrder ParentOrder @relation(fields: [parentOrderId], references: [id])
  items       BookingItem[]

  @@index([vendorId])
  @@index([businessId])
}

model BookingItem {
  id            Int     @id @default(autoincrement())
  uuid          String  @unique @default(uuid()) @db.VarChar(36)
  vendorOrderId Int
  productId     String  @db.VarChar(36)
  productName   String  @db.VarChar(255)
  sku           String  @db.VarChar(100)
  variant       Json?
  unitPrice     Decimal @db.Decimal(12, 2)
  quantity      Int
  tax           Decimal @default(0) @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id])
}
